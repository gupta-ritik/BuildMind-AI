# --- LLM provider (OpenAI-compatible; swap provider without code changes) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Or, to use OpenAI directly:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Persistence (Phase 5+) ---
# REQUIRED: PostgreSQL. The LangGraph checkpointer is Postgres-backed, not
# SQLite-compatible - the app will refuse to start with a clear error if
# this isn't a valid, reachable postgresql:// URL. Local dev setup:
#   sudo -u postgres psql -c "CREATE USER codepilot WITH PASSWORD 'codepilot_dev_password';"
#   sudo -u postgres psql -c "CREATE DATABASE codepilot OWNER codepilot;"
DATABASE_URL=postgresql+psycopg2://codepilot:codepilot_dev_password@localhost:5432/codepilot
REDIS_URL=redis://localhost:6379/0

# --- Agent limits ---
MAX_DEBUG_RETRIES=3
MAX_REVIEW_CYCLES=2
MAX_AGENT_ITERATIONS=25
TOOL_TIMEOUT_SECONDS=60

# --- Docker sandbox (Phase 2) ---
USE_DOCKER_SANDBOX=true
DOCKER_IMAGE=python:3.12-slim
DOCKER_MEM_LIMIT=512m
DOCKER_NANO_CPUS=1000000000

# --- Workspace ---
WORKSPACE_ROOT=/tmp/codepilot_workspaces

# --- GitHub (used from Phase 4 onward) ---
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Observability (used from Phase 7 onward) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=codepilot
